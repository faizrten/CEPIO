{
  "dataset": "cepio-synthetic-drilling",
  "version": "0.2.0",
  "inherits": "drilling-v0.1",
  "purpose": "Multimodal CEPIO conformance fixture for industrial identity, context, provenance and temporal evidence binding.",
  "ontology_alignment": {
    "rig": "https://cepio.org/ontology/drilling#OperatingRig",
    "equipment": "https://cepio.org/ontology/drilling#DrillingEquipment",
    "activity": "https://cepio.org/ontology/drilling#ActivityInterval",
    "document": "https://cepio.org/ontology/core#Document",
    "measurement": "https://cepio.org/ontology/core#Measurement",
    "condition_signal": "https://cepio.org/ontology/reliability#ConditionSignal",
    "work_order": "https://cepio.org/ontology/industrial#WorkOrder",
    "failure_event": "https://cepio.org/ontology/reliability#FailureEvent"
  },
  "modalities": {
    "structured_tabular": {"status": "inherited", "examples": ["equipment.csv", "work_orders.csv", "npt_events.csv"]},
    "low_frequency_time_series": {"status": "inherited", "examples": ["telemetry.csv"]},
    "event_temporal": {"status": "inherited", "examples": ["failure_events.csv", "maintenance_events.csv"]},
    "document": {"status": "new", "format": "Markdown", "binding": "canonical asset + scenario + event time"},
    "inspection_image": {"status": "new", "format": "PPM P3", "binding": "canonical asset + scenario + observed feature"},
    "engineering_diagram": {"status": "new", "format": "SVG", "binding": "canonical asset + component relationship"},
    "geospatial": {"status": "new", "format": "GeoJSON", "binding": "rig/well canonical identity + move path"},
    "high_frequency_signal": {"status": "new", "format": "CSV waveform", "binding": "canonical asset + scenario + event time"}
  },
  "artifact_policy": {
    "store_raw_payload_in_ontology": false,
    "required_metadata": ["artifact_id", "modality", "canonical_iri", "scenario_id", "event_time", "provenance"],
    "principle": "CEPIO stores semantic binding and provenance while source-native artifacts remain external payloads."
  }
}
