@prefix cepio: <https://cepio.org/ontology/core#> .
@prefix kin: <https://cepio.org/ontology/kinetic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

kin:ActionType a owl:Class ; rdfs:subClassOf cepio:Entity .
kin:Decision a owl:Class ; rdfs:subClassOf cepio:Entity .
kin:Function a owl:Class ; rdfs:subClassOf cepio:Entity .
kin:Rule a owl:Class ; rdfs:subClassOf cepio:Entity .
kin:Constraint a owl:Class ; rdfs:subClassOf cepio:Entity .
kin:Workflow a owl:Class ; rdfs:subClassOf cepio:Process .
kin:Approval a owl:Class ; rdfs:subClassOf cepio:Event .

# Universal prospective decision semantics.
# Opportunity is intentionally Kinetic rather than Core: Core describes what the
# enterprise knows; Kinetic describes what it may choose to pursue or change.
kin:Opportunity a owl:Class ;
  rdfs:subClassOf cepio:Entity ;
  rdfs:comment "A prospective, actionable situation in which one or more options could advance an objective or avoid loss." .
kin:Option a owl:Class ;
  rdfs:subClassOf cepio:Entity ;
  rdfs:comment "A possible course of action evaluated in an opportunity or decision context." .
kin:Recommendation a owl:Class ;
  rdfs:subClassOf cepio:Entity ;
  rdfs:comment "A reasoned proposal favoring one or more options without constituting the authoritative decision." .

kin:permitsAction a owl:ObjectProperty .
kin:requiresApproval a owl:ObjectProperty .
kin:invokesFunction a owl:ObjectProperty .
kin:governedBy a owl:ObjectProperty .
kin:resultsIn a owl:ObjectProperty .

kin:opportunityForObjective a owl:ObjectProperty ;
  rdfs:domain kin:Opportunity ;
  rdfs:range cepio:Objective .
kin:hasOption a owl:ObjectProperty ;
  rdfs:domain kin:Opportunity ;
  rdfs:range kin:Option .
kin:hasRecommendation a owl:ObjectProperty ;
  rdfs:domain kin:Opportunity ;
  rdfs:range kin:Recommendation .
kin:recommendsOption a owl:ObjectProperty ;
  rdfs:domain kin:Recommendation ;
  rdfs:range kin:Option .
kin:addressesOpportunity a owl:ObjectProperty ;
  rdfs:domain kin:Decision ;
  rdfs:range kin:Opportunity .
kin:selectedOption a owl:ObjectProperty ;
  rdfs:domain kin:Decision ;
  rdfs:range kin:Option .
kin:basedOnRecommendation a owl:ObjectProperty ;
  rdfs:domain kin:Decision ;
  rdfs:range kin:Recommendation .
