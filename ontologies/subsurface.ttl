@prefix cepio: <https://cepio.org/ontology/core#> .
@prefix energy: <https://cepio.org/ontology/energy#> .
@prefix sub: <https://cepio.org/ontology/subsurface#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# CEPIO Subsurface owns assurance, reasoning and decision context, not OSDU
# technical payloads. OSDU/ADME remains authoritative for well, log, sample,
# interpretation and reservoir-model data.

sub:PetrophysicsAssuranceCase a owl:Class ;
    rdfs:subClassOf cepio:Entity ;
    rdfs:comment "A governed Petrophysics reasoning/assurance context that binds evidence, assumptions, uncertainty, authority and downstream consequences without copying technical source payloads." .

sub:FormationEvaluationCase a owl:Class ;
    rdfs:subClassOf sub:PetrophysicsAssuranceCase .

# Domain assessment specializations remain thin. Core defines Assessment,
# Evidence, Claim, Hypothesis, Assumption, Uncertainty and Confidence semantics.
sub:DataReadinessAssessment a owl:Class ;
    rdfs:subClassOf cepio:Assessment .

sub:SaturationContactAssessment a owl:Class ;
    rdfs:subClassOf cepio:Assessment .

sub:InterpretationConsistencyAssessment a owl:Class ;
    rdfs:subClassOf cepio:Assessment .

sub:RemainingHydrocarbonAssessment a owl:Class ;
    rdfs:subClassOf cepio:Assessment .

sub:NewWellLearningAssessment a owl:Class ;
    rdfs:subClassOf cepio:Assessment .

sub:ModelHandoverTrace a owl:Class ;
    rdfs:subClassOf cepio:Entity ;
    rdfs:comment "A traceable handover context linking an authoritative petrophysical interpretation to downstream model transformations and consumers." .

# A first-class subject for Core Assessment objects. Domains define what is
# uncertain; Core defines how uncertainty/confidence assessments behave.
sub:PetrophysicalCharacteristic a owl:Class ;
    rdfs:subClassOf cepio:Entity .

sub:EffectivePorosityCharacteristic a owl:Class ;
    rdfs:subClassOf sub:PetrophysicalCharacteristic .

sub:WaterSaturationCharacteristic a owl:Class ;
    rdfs:subClassOf sub:PetrophysicalCharacteristic .

sub:PermeabilityCharacteristic a owl:Class ;
    rdfs:subClassOf sub:PetrophysicalCharacteristic .

sub:NetReservoirCharacteristic a owl:Class ;
    rdfs:subClassOf sub:PetrophysicalCharacteristic .

sub:NetPayCharacteristic a owl:Class ;
    rdfs:subClassOf sub:PetrophysicalCharacteristic .

sub:FluidContactCharacteristic a owl:Class ;
    rdfs:subClassOf sub:PetrophysicalCharacteristic .

# Authority is represented as operational state of the CEPIO assurance case
# rather than by overwriting the externally authoritative interpretation record.
sub:FormationEvaluationState a owl:Class ;
    rdfs:subClassOf cepio:State .

sub:Draft a sub:FormationEvaluationState .
sub:UnderReview a sub:FormationEvaluationState .
sub:Approved a sub:FormationEvaluationState .
sub:Authoritative a sub:FormationEvaluationState .
sub:Superseded a sub:FormationEvaluationState .
sub:Rejected a sub:FormationEvaluationState .

sub:caseForWell a owl:ObjectProperty ;
    rdfs:domain sub:FormationEvaluationCase ;
    rdfs:range energy:Well .

sub:hasCharacteristic a owl:ObjectProperty ;
    rdfs:domain sub:FormationEvaluationCase ;
    rdfs:range sub:PetrophysicalCharacteristic .

sub:hasFormationEvaluationState a owl:ObjectProperty ;
    rdfs:domain sub:FormationEvaluationCase ;
    rdfs:range sub:FormationEvaluationState .

sub:assuranceForWell a owl:ObjectProperty ;
    rdfs:domain sub:PetrophysicsAssuranceCase ;
    rdfs:range energy:Well .

sub:tracesFromCase a owl:ObjectProperty ;
    rdfs:domain sub:ModelHandoverTrace ;
    rdfs:range sub:FormationEvaluationCase .

sub:tracesTo a owl:ObjectProperty ;
    rdfs:domain sub:ModelHandoverTrace ;
    rdfs:range cepio:Entity .
