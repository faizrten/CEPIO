@prefix cepio: <https://cepio.org/ontology/core#> .
@prefix ind: <https://cepio.org/ontology/industrial#> .
@prefix rel: <https://cepio.org/ontology/reliability#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

rel:FailureMode a owl:Class ; rdfs:subClassOf cepio:Entity .
rel:FailureEvent a owl:Class ; rdfs:subClassOf cepio:Event .
rel:DowntimeEvent a owl:Class ; rdfs:subClassOf cepio:Event .
rel:ComponentLife a owl:Class ; rdfs:subClassOf cepio:Measurement .

# Reusable governed condition evidence for procedural reasoning. This is additive:
# the pre-existing ConditionSignal contract remains unchanged for existing consumers.
rel:ConditionObservation a owl:Class ; rdfs:subClassOf cepio:Measurement .
rel:ConditionSignal a owl:Class ; rdfs:subClassOf cepio:Measurement .
rel:RemainingUsefulLifeEstimate a owl:Class ; rdfs:subClassOf cepio:Measurement .

# Reusable mechanical-integrity semantics accepted by the refinery v0.2
# Generalization Lab. These concepts are industrial-common because damage
# mechanisms and RBI apply across refineries, chemicals, upstream facilities
# and other integrity-intensive industrial assets.
rel:DamageMechanism a owl:Class ; rdfs:subClassOf cepio:Entity .
rel:RiskBasedInspectionAssessment a owl:Class ; rdfs:subClassOf cepio:Risk .

rel:failureOfEquipment a owl:ObjectProperty ; rdfs:domain rel:FailureEvent ; rdfs:range ind:Equipment .
rel:hasFailureMode a owl:ObjectProperty ; rdfs:domain rel:FailureEvent ; rdfs:range rel:FailureMode .
rel:repairedByWorkOrder a owl:ObjectProperty ; rdfs:domain rel:FailureEvent ; rdfs:range ind:WorkOrder .
rel:hasComponentLife a owl:ObjectProperty ; rdfs:domain ind:Equipment ; rdfs:range rel:ComponentLife .
rel:causesDowntime a owl:ObjectProperty ; rdfs:domain cepio:Event ; rdfs:range rel:DowntimeEvent .
rel:hasConditionObservation a owl:ObjectProperty ; rdfs:domain ind:Equipment ; rdfs:range rel:ConditionObservation .
rel:observedOnEquipment a owl:ObjectProperty ; rdfs:domain rel:ConditionSignal ; rdfs:range ind:Equipment .
rel:estimatesLifeOf a owl:ObjectProperty ; rdfs:domain rel:RemainingUsefulLifeEstimate ; rdfs:range ind:Equipment .
rel:damageMechanismForEquipment a owl:ObjectProperty ; rdfs:domain rel:DamageMechanism ; rdfs:range ind:Equipment .
rel:assessmentForEquipment a owl:ObjectProperty ; rdfs:domain rel:RiskBasedInspectionAssessment ; rdfs:range ind:Equipment .
rel:assessmentConsidersDamageMechanism a owl:ObjectProperty ; rdfs:domain rel:RiskBasedInspectionAssessment ; rdfs:range rel:DamageMechanism .
rel:assessmentUsesInspection a owl:ObjectProperty ; rdfs:domain rel:RiskBasedInspectionAssessment ; rdfs:range ind:Inspection .
