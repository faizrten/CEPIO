@prefix cepio: <https://cepio.org/ontology/core#> .
@prefix comm: <https://cepio.org/ontology/commercial#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

comm:ContractObligation a owl:Class ; rdfs:subClassOf cepio:WorkItem .
comm:ContractRate a owl:Class ; rdfs:subClassOf cepio:Entity .
comm:RateBasis a owl:Class ; rdfs:subClassOf cepio:Entity .
comm:FinancialActual a owl:Class ; rdfs:subClassOf cepio:Measurement .
comm:RevenueRecord a owl:Class ; rdfs:subClassOf cepio:Measurement .
comm:CostRecord a owl:Class ; rdfs:subClassOf cepio:Measurement .
comm:CapitalItem a owl:Class ; rdfs:subClassOf cepio:Resource .
comm:EconomicEvent a owl:Class ; rdfs:subClassOf cepio:Event .
comm:ValueAtRisk a owl:Class ; rdfs:subClassOf cepio:Risk .
comm:PriceDeck a owl:Class ; rdfs:subClassOf cepio:Entity .
comm:EconomicScenario a owl:Class ; rdfs:subClassOf cepio:Entity .

# Reusable contracted-service execution boundary. These semantics apply to
# drilling services, industrial maintenance, inspection and EPC delivery.
comm:ServiceExecution a owl:Class ; rdfs:subClassOf cepio:Activity .
comm:ServiceDeliveryEvidence a owl:Class ; rdfs:subClassOf cepio:Document .
comm:ServiceAcceptance a owl:Class ; rdfs:subClassOf cepio:Event .

comm:obligationOfContract a owl:ObjectProperty ; rdfs:domain comm:ContractObligation ; rdfs:range cepio:Contract .
comm:rateForContract a owl:ObjectProperty ; rdfs:domain comm:ContractRate ; rdfs:range cepio:Contract .
comm:hasRateBasis a owl:ObjectProperty ; rdfs:domain comm:ContractRate ; rdfs:range comm:RateBasis .
comm:financialActualFor a owl:ObjectProperty ; rdfs:domain comm:FinancialActual ; rdfs:range cepio:Entity .
comm:revenueFor a owl:ObjectProperty ; rdfs:domain comm:RevenueRecord ; rdfs:range cepio:Entity .
comm:costFor a owl:ObjectProperty ; rdfs:domain comm:CostRecord ; rdfs:range cepio:Entity .
comm:capitalItemFor a owl:ObjectProperty ; rdfs:domain comm:CapitalItem ; rdfs:range cepio:Asset .

comm:serviceExecutionForActivity a owl:ObjectProperty ; rdfs:domain comm:ServiceExecution ; rdfs:range cepio:Activity .
comm:performedBy a owl:ObjectProperty ; rdfs:domain comm:ServiceExecution ; rdfs:range cepio:Party .
comm:governedByObligation a owl:ObjectProperty ; rdfs:domain comm:ServiceExecution ; rdfs:range comm:ContractObligation .
comm:producesDeliveryEvidence a owl:ObjectProperty ; rdfs:domain comm:ServiceExecution ; rdfs:range comm:ServiceDeliveryEvidence .
comm:acceptanceOfService a owl:ObjectProperty ; rdfs:domain comm:ServiceAcceptance ; rdfs:range comm:ServiceExecution .
comm:acceptedBy a owl:ObjectProperty ; rdfs:domain comm:ServiceAcceptance ; rdfs:range cepio:Party .
