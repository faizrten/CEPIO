          "skill_id": {
            "title": "Skill Id",
            "type": "string"
          }
        },
        "required": [
          "skill_id",
          "executable",
          "authority"
        ],
        "title": "SkillDescriptor",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
