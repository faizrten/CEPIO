        "properties": {
          "local_only": {
            "default": true,
            "title": "Local Only",
            "type": "boolean"
          },
          "metadata": {
            "$ref": "#/components/schemas/ManagementMetadata"
          },
          "read_only": {
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "scope": {
            "const": "process-only",
            "default": "process-only",
            "title": "Scope",
            "type": "string"
          },
          "status": {
            "const": "healthy",
            "default": "healthy",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "RuntimeHealth",
        "type": "object"
      },
