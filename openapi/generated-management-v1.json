            "type": "array"
          },
          "decisions": {
            "items": {
              "type": "string"
            },
            "title": "Decisions",
            "type": "array"
          },
          "deployment_recorded": {
            "default": false,
            "title": "Deployment Recorded",
            "type": "boolean"
          },
          "functions": {
            "items": {
              "type": "string"
            },
            "title": "Functions",
            "type": "array"
          },
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          },
          "requires_core": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requires Core"
          },
          "requires_packs": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Requires Packs",
            "type": "object"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "version"
        ],
        "title": "IndustryIQPackDescriptor",
        "type": "object"
      },
      "InvestigationOperations": {
        "description": "No customer records; only a trusted, tenant-scoped aggregate may populate counts.",
        "properties": {
          "counts": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counts"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "reason": {
            "default": "No tenant-scoped investigation operations observer configured",
            "title": "Reason",
            "type": "string"
          },
          "state": {
            "default": "not-connected",
            "enum": [
              "not-connected",
              "available",
              "degraded"
            ],
            "title": "State",
            "type": "string"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },
        "title": "InvestigationOperations",
        "type": "object"
      },
      "ManagementMetadata": {
        "properties": {
          "contract_version": {
            "const": "0.1.0",
            "default": "0.1.0",
            "title": "Contract Version",
            "type": "string"
          }
        },
        "title": "ManagementMetadata",
        "type": "object"
      },
