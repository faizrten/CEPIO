            "title": "Strict Properties",
            "type": "boolean"
          },
          "validate_properties": {
            "title": "Validate Properties",
            "type": "boolean"
          },
          "validate_types": {
            "title": "Validate Types",
            "type": "boolean"
          }
        },
        "required": [
          "cepio_version",
          "environment",
          "persistence_mode",
          "application_auth_mode",
          "validate_types",
          "validate_properties",
          "strict_properties"
        ],
