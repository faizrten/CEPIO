          "binding_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Binding Id"
          },
          "decision_capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Decision Capabilities",
            "type": "array"
          },
          "executable": {
            "title": "Executable",
            "type": "boolean"
          },
          "readiness": {
            "const": "actor-preflight-required",
            "default": "actor-preflight-required",
            "title": "Readiness",
            "type": "string"
          },
          "required_industry_iq": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Required Industry Iq",
            "type": "object"
