{
  "components": {
    "schemas": {
      "BindingDescriptor": {
        "description": "Management projection of an explicitly registered Binding Contract.",
        "properties": {
          "authority": {
            "title": "Authority",
            "type": "string"
          },
          "binding_contract_version": {
            "default": "0.1",
            "title": "Binding Contract Version",
            "type": "string"
          },
          "binding_id": {
            "title": "Binding Id",
            "type": "string"
          },
          "capability": {
            "title": "Capability",
            "type": "string"
          },
          "declared_capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Declared Capabilities",
            "type": "array"
          },
          "last_checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Checked At"
          },
          "mode": {
            "enum": [
              "read",
              "write",
              "read-write"
            ],
            "title": "Mode",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "source_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source System"
          },
          "status": {
            "enum": [
              "ready",
              "degraded",
              "not-configured"
            ],
            "title": "Status",
            "type": "string"
          },
          "verification_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Ref"
          },
          "verified_readiness": {
            "default": "not-verified",
            "enum": [
              "not-verified",
              "verified",
              "failed",
              "stale"
            ],
            "title": "Verified Readiness",
            "type": "string"
          }
        },
        "required": [
          "binding_id",
          "provider",
          "capability",
          "mode",
          "status",
          "authority"
        ],
        "title": "BindingDescriptor",
        "type": "object"
      },
      "CapabilityInventory": {
        "properties": {
          "application_contract_available": {
            "default": true,
            "title": "Application Contract Available",
            "type": "boolean"
          },
          "binding_contract_version": {
            "default": "0.1",
            "title": "Binding Contract Version",
            "type": "string"
          },
          "binding_count": {
            "title": "Binding Count",
            "type": "integer"
          },
          "binding_inventory_state": {
            "default": "not-wired",
            "enum": [
              "connected",
              "not-wired"
            ],
            "title": "Binding Inventory State",
            "type": "string"
          },
          "executable_skill_count": {
            "title": "Executable Skill Count",
            "type": "integer"
          },
          "industry_iq_pack_count": {
            "title": "Industry Iq Pack Count",
            "type": "integer"
          },
          "management_contract_version": {
            "default": "0.1.0",
            "title": "Management Contract Version",
            "type": "string"
          },
          "profile_count": {
            "title": "Profile Count",
            "type": "integer"
          },
          "readiness_qualified": {
            "default": false,
            "title": "Readiness Qualified",
            "type": "boolean"
          },
          "registered_action_count": {
            "default": 0,
            "title": "Registered Action Count",
            "type": "integer"
          },
          "registered_decision_count": {
            "default": 0,
            "title": "Registered Decision Count",
            "type": "integer"
          },
          "registered_function_count": {
            "default": 0,
            "title": "Registered Function Count",
            "type": "integer"
          },
          "skill_count": {
            "title": "Skill Count",
            "type": "integer"
          },
          "skill_inventory_source": {
            "const": "shipped-specifications",
            "default": "shipped-specifications",
            "title": "Skill Inventory Source",
            "type": "string"
          }
        },
        "required": [
          "skill_count",
          "executable_skill_count",
          "industry_iq_pack_count",
          "binding_count",
          "profile_count"
        ],
        "title": "CapabilityInventory",
        "type": "object"
      },
