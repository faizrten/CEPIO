        "properties": {
          "approval_required_for": {
            "items": {
              "type": "string"
            },
            "title": "Approval Required For",
            "type": "array"
          },
          "execute_actions": {
            "items": {
              "type": "string"
            },
            "title": "Execute Actions",
            "type": "array"
          },
          "propose_decision": {
            "title": "Propose Decision",
