# EXPERIMENT ONLY: never selected by deployment workflows.
FROM python:3.11.17-slim-trixie@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377 AS os-base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000
RUN apt-get update -o APT::Update::Error-Mode=any && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-remove && apt-get clean && rm -rf /var/lib/apt/lists/*

FROM os-base AS builder
WORKDIR /build
COPY . /build
RUN python -m pip install --no-cache-dir --upgrade pip build "setuptools==84.2.1" && python -m build --wheel

FROM os-base AS test-runner
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . /build
RUN python -m pip install --no-cache-dir --upgrade pip "setuptools==84.2.1" && python -m pip install --no-cache-dir -c experiments/base-images/runtime-constraints.txt '.[dev]'
WORKDIR /work
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "--basetemp=/tmp/pytest"]

FROM os-base AS installed
WORKDIR /app
RUN groupadd --system cepio && useradd --system --gid cepio --home-dir /nonexistent --shell /usr/sbin/nologin cepio
COPY --from=builder /build/dist/cepio-*.whl /tmp/
COPY experiments/base-images/runtime-constraints.txt /tmp/constraints.txt
RUN python -m pip install --no-cache-dir --upgrade pip "setuptools==84.2.1" && wheel="$(ls /tmp/cepio-*.whl)" && python -m pip install --no-cache-dir --only-binary=:all: -c /tmp/constraints.txt "${wheel}[mcp]" && python -m pip check && python -m pip freeze --all > /tmp/runtime-freeze.txt

FROM installed AS optional-probe
RUN apt-get update && apt-get install -y --no-install-recommends libltdl7 libkrb5-3 libgssapi-krb5-2 && rm -rf /var/lib/apt/lists/*
RUN wheel="$(ls /tmp/cepio-*.whl)" && python -m pip install --no-cache-dir --only-binary=:all: -c /tmp/constraints.txt "${wheel}[mcp,otel,fabric-sql]" && python -m pip check && python -c "import mssql_python, azure.identity, opentelemetry.trace"
RUN python -c "import ctypes, json, mssql_python; info=mssql_python.get_native_provider_info(); ctypes.CDLL(info['driver_path']); print(json.dumps(info))"

FROM installed AS runtime
RUN python -m pip uninstall --yes pip && python -c "import pathlib, shutil, sysconfig; p=pathlib.Path(sysconfig.get_path('stdlib'))/'ensurepip'; shutil.rmtree(p, ignore_errors=True)" && python -c "import importlib.util; assert importlib.util.find_spec('pip') is None; assert importlib.util.find_spec('ensurepip') is None" && rm -f /tmp/cepio-*.whl /tmp/constraints.txt
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} + && mkdir -p /app /data && chown -R cepio:cepio /app /data
COPY scripts/minimize_runtime.py /tmp/minimize_runtime.py
COPY experiments/base-images/minimize.py /tmp/minimize.py
RUN python /tmp/minimize.py && rm /tmp/minimize.py /tmp/minimize_runtime.py
USER cepio
EXPOSE 8000
CMD ["sh", "-c", "uvicorn cepio.host_api:app --host 0.0.0.0 --port ${PORT:-8000}"]
